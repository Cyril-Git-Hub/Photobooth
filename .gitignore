# Environnement et construction
.venv/
__pycache__/
build/
dist/
*.pyc

# Données de la soirée : ne jamais versionner (photos d'invités, adresses mail, mot de passe)
config.ini
config.ini.bak
invites.xlsx
photos/
data/
logs/
exports/
debug/
fonds/*
!fonds/.gitkeep
cadres/*
!cadres/.gitkeep
masques/*
!masques/.gitkeep

# Médias de thèmes personnalisés ; les manifestes et dossiers classiques restent versionnés
themes/*/fonds/*
!themes/*/fonds/.gitkeep
themes/*/cadres/*
!themes/*/cadres/.gitkeep
themes/*/visuels/*
!themes/*/visuels/.gitkeep
themes/*/sons/*
!themes/*/sons/.gitkeep
!themes/classique/sons/compte_a_rebours.wav
!themes/classique/sons/declencheur.wav
!themes/classique/sons/reussite.wav

# Modèles IA (téléchargés par photobooth-outils --telecharger-modeles)
models/*.tflite

# Cache local de PowerShell (créé automatiquement par Windows)
/Microsoft/Windows/PowerShell/ModuleAnalysisCache
